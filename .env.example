# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# ElevenLabs TTS Configuration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Supabase Configuration (Optional - only needed if using database features)
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here

# Application Configuration
# PORT is automatically set by Railway, but you can override locally
PORT=8000

# Base URL for audio file serving (set this to your Railway deployment URL in production)
BASE_PUBLIC_URL=http://localhost:8000
